# Copy to .env for local development. Never commit a real .env.
# See docs/relayer.md "Key management" for the production path.

RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337

CASCADE_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000
EXECUTION_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000
ATTRIBUTION_SETTLEMENT_ADDRESS=0x0000000000000000000000000000000000000000

# Development only. Production should replace src/signer.ts's
# createSigner() with a KMS/HSM-backed implementation instead of setting
# this — the rest of the relayer depends only on the ethers.Signer
# interface, not on how it's backed.
RELAYER_PRIVATE_KEY=

HTTP_PORT=8787
CONFIRMATIONS=1
CONFIRMATION_TIMEOUT_MS=60000
MAX_SUBMISSION_ATTEMPTS=5
RETRY_BASE_DELAY_MS=1000
RETRY_MAX_DELAY_MS=30000
GAS_BUMP_PER_ATTEMPT=20
