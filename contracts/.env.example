# Copy to .env for a real deployment. Never commit a real .env.
# Only needed for `npm run deploy -- --network target` — `npm test` and
# `npm run build` never read these and are unaffected if unset.
#
# Hardhat itself does not auto-load .env files; export these into your
# shell, or run via a tool like `dotenv-cli` (e.g.
# `npx dotenv -e .env -- npm run deploy -- --network target`).
# See docs/deployment.md.

# The RPC endpoint to deploy to. Leaving this unset means hardhat.config.ts
# does not define the "target" network at all — `--network target` will
# fail with a clear Hardhat error rather than silently deploying somewhere
# unintended.
RPC_URL=

# Optional. If unset, Hardhat infers the chain ID from RPC_URL itself.
CHAIN_ID=

# Required to deploy to anything other than Hardhat's own local network —
# a raw private key, development convenience only. Production deployments
# should use a hardware wallet / KMS-backed signer instead (out of scope
# for this script — see docs/deployment.md's "production signing" note).
DEPLOYER_PRIVATE_KEY=

# CascadeRegistry's challenge resolver (docs/adr/0004) — a real,
# deliberately chosen address, not guessed. If left unset, the deploy
# script defaults to the deploying account and prints a loud warning;
# do not rely on that default for anything beyond local/test deployments.
RESOLVER_ADDRESS=

# Confirmations to wait for after each deployment transaction before
# moving to the next contract. 1 is fine for a local/test network; a real
# network under active load may warrant more.
CONFIRMATIONS=1
