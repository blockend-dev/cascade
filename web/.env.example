# Copy to .env for local development. Never commit a real .env.
# Vite only exposes variables prefixed VITE_ to client code — see
# https://vitejs.dev/guide/env-and-mode.html.

VITE_RPC_URL=http://127.0.0.1:8545
VITE_CHAIN_ID=31337
VITE_CHAIN_NAME=Hardhat Local

VITE_INDEXER_URL=http://127.0.0.1:8788

VITE_CASCADE_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000
VITE_EXECUTION_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000
VITE_ATTRIBUTION_SETTLEMENT_ADDRESS=0x0000000000000000000000000000000000000000
VITE_TRAINING_PROVENANCE_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000

# Optional: link to a block explorer for tx/address links. Leave blank to omit the link.
VITE_EXPLORER_BASE_URL=
